# Environment Configuration Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Production MySQL Database Connection (Aiven or custom)
SPRING_DATASOURCE_URL=jdbc:mysql://<your-db-host>:11446/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# JWT Security Configuration
APP_JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_bytes
APP_JWT_EXPIRATION_MS=604800000

# Google OAuth2 Authentication (For future Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Service Microservice URL (Hosted on Render)
AI_SERVICE_URL=https://ai-service-ky1g.onrender.com/chat
APP_PUBLIC_SITE_BASE_URL=https://website-templates-weld.vercel.app

# Cloudinary Image Storage (for public HTTPS image URLs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend API (Transactional Emails on Render)
RESEND_API_KEY=re_your_resend_api_key
APP_MAIL_FROM=onboarding@resend.dev

# Meta / Instagram Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://backend-1-uaj1.onrender.com/api/social/instagram/callback
