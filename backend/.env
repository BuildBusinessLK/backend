# ── MySQL (dev local) ──────────────────────────────────────────
# These override application-dev.properties when present
spring.datasource.url=jdbc:mysql://localhost:3306/buildbusinesslk?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

# ── JWT ────────────────────────────────────────────────────────
app.jwt.secret=BuildBusinessLK-Dev-Secret-At-Least-Thirty-Two-Bytes-Long-Key
app.jwt.expiration-ms=604800000

# ── AI Service URLs ───────────────────────────────────────────
ai.service.url=http://localhost:8000/chat
ai.service.website-copy-url=http://localhost:8000/website-copy

# ── Public website template base URL ─────────────────────────
app.public-site.base-url=http://localhost:3001

# ── Email (SMTP) ──────────────────────────────────────────────
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_APP_PASSWORD
app.mail.from=YOUR_EMAIL@gmail.com

# ── OpenAI (used by EmailService & SocialMediaService) ────────
app.openai.apiKey=YOUR_OPENAI_API_KEY
app.openai.model=gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# ── Prod DB password (only needed when spring.profiles.active=prod) ──
SPRING_DATASOURCE_PASSWORD=YOUR_PROD_DB_PASSWORD
